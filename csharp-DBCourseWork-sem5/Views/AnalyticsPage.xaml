<Page x:Class="csharp_DBCourseWork_sem5.Pages.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:oxy="http://oxyplot.org/wpf"
      Title="Аналитика" Background="AliceBlue" >

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="BarRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}"
                           Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                             Height="14" Margin="8,0" BorderThickness="0"
                             Foreground="#FF4FC3F7" Background="#FF3F3F3F"/>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}"
                           Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Аналитика продаж" Foreground="Black"
                   FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Период:" Foreground="Black" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="120"/>
            <TextBlock Text="—" Foreground="White" VerticalAlignment="Center" Margin="6,0"/>
            <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="120"/>
            <Button Content="⟳ Обновить" Padding="12,3" Margin="14,0,0,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="Экспорт в Excel" Padding="12,3" Margin="10,0,0,0"
                    Command="{Binding ExportCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Border Background="#FF5A1F1F" CornerRadius="6" Padding="10,6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorText}" Foreground="White" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Выручка"/>
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding Revenue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Заказов"/>
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding Orders}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Средний чек"/>
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding AvgCheck}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="Прибыль"/>
                            <TextBlock Style="{StaticResource CardValue}" Text="{Binding Profit}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="Нет данных за выбранный период" Foreground="#FFB0B0B0" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,20"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Выручка по месяцам (последние 12)"/>
                        <oxy:PlotView Model="{Binding MonthPlot}" Height="260" Background="#FF2D2D2D"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Топ-10 книг по выручке"/>
                            <ItemsControl ItemsSource="{Binding TopBooks}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Выручка по типам клиентов"/>
                            <ItemsControl ItemsSource="{Binding ByCustomerType}" ItemTemplate="{StaticResource BarRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>