<Window x:Class="csharp_DBCourseWork_sem5.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_DBCourseWork_sem5"
        xmlns:vm="clr-namespace:csharp_DBCourseWork_sem5.ViewModels"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="450" WindowStyle="None" 
        FontFamily="Bahnschrift" FontSize="25" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Visibility="Visible">
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/LogWinBack.jpg" Panel.ZIndex="-20" Grid.ColumnSpan="3" Grid.RowSpan="3"/>

        <Rectangle Fill="Black" VerticalAlignment="Top" Width="auto" Height="40" Grid.ColumnSpan="3"/>

        <Grid Visibility="Visible" Grid.Column="1" Grid.Row="1">

            <Rectangle Fill="#80FFFFFF" Width="300" Height="200" Grid.Column="1" Grid.Row="1" RadiusX="20" RadiusY="20" 
                   VerticalAlignment="Top" Margin="0 40 0 0"/>
            <StackPanel Grid.Column="1" Grid.Row="1" Height="auto" Width="260" Margin="0 50 0 0" VerticalAlignment="Top">
                <Image Source="/Images/UserIcon.png" Height="64" Width="64" Margin="5"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Images/UserIcon2.png" Height="40" Width="40"/>

                    <Border CornerRadius="10" BorderThickness="2.5" BorderBrush="White" Padding="8,0" Margin="3">
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White"
                            MinHeight="30" Height="40" MinWidth="150" MaxWidth="150" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                            VerticalContentAlignment="Center" ToolTip="Введите логин" Name="txtLogin"/>
                    </Border>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/Images/LockIcon.png" Height="40" Width="40"/>

                    <Border CornerRadius="10" BorderThickness="2.5" BorderBrush="White" Padding="8,0" Margin="3">
                        <PasswordBox Background="Transparent" BorderThickness="0" Foreground="White"
                             MinHeight="30" Height="40" MinWidth="150" MaxWidth="150"
                             VerticalContentAlignment="Center" ToolTip="Введите пароль" PasswordChanged="PasswordBox_PasswordChanged"/>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <Border x:Name="brdLogin" Height="50" Width="240" BorderThickness="0.5" CornerRadius="10" Background="#80FFFFFF" Cursor="Hand" 
                Padding="8,0" Margin="0 0 0 50" VerticalAlignment="Bottom" Grid.Column="1" Grid.Row="1" 
                MouseEnter="brdLogin_MouseEnter" MouseLeave="brdLogin_MouseLeave">

                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                      Command="{Binding LoginCommand}" />
                </Border.InputBindings>

                <TextBlock Text="Войти" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.ColumnSpan="2" Width="auto" HorizontalAlignment="Right">
            <Label Content="⚙" Foreground="White" Width="40" Margin="2" Padding="4,4,5,5" MouseLeftButtonDown="OpenSettings_Click"/>

            <Label Content="?" Foreground="white" Width="40" ToolTip="Справка" Cursor="Help" 
                   HorizontalContentAlignment="Center" Margin="2">
                <Label.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Руководство пользователя" Click="OpenPage_Click"/>
                        <MenuItem Header="О программе" Click="OpenPage_Click"/>
                    </ContextMenu>
                </Label.ContextMenu>
            </Label>

            <Button Content="x" Foreground="white" ToolTip="Закрыть" Width="40" HorizontalContentAlignment="Center"
                    Background="Transparent" BorderThickness="0" Click="Close_Click" IsCancel="True" Margin="2" Padding="10,3,10,5"/>
        </StackPanel>


        <Label Grid.Row="3" Grid.ColumnSpan="2" Content="Забыли пароль?" Foreground="White" VerticalAlignment="Bottom"
               MouseLeftButtonDown="ChangePassword_Click"/>

        <Frame Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="3" Name="fmPage" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
    </Grid>
</Window>
