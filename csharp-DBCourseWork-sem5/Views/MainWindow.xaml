<Window x:Class="csharp_DBCourseWork_sem5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_DBCourseWork_sem5"
        xmlns:vm="clr-namespace:csharp_DBCourseWork_sem5.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000" WindowStyle="None"
        FontFamily="Bahnschrift" FontSize="20" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Gesture="F5" Command="{Binding RunCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- Разделители -->
        <GridSplitter Grid.Column="1" Grid.RowSpan="4" Width="6" 
            HorizontalAlignment="Center" VerticalAlignment="Stretch" 
            ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" 
            Background="#FF454141" Cursor="SizeWE"/>

        <GridSplitter Grid.Column="2" Grid.Row="2" Height="6" 
            HorizontalAlignment="Stretch" VerticalAlignment="Center" 
            ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" 
            Background="#FF454141" Cursor="SizeNS"/>

        <Grid Grid.Column="2" Grid.Row="1" Background="#FF454141">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <!-- Кнопка "Выполнить" -->
                <Button Grid.Row="0" Content="▶" Style="{StaticResource SubMenuButton}" Width="30" Height="30" Margin="3" 
                        Command="{Binding RunCommand}" ToolTip="Запустить скрипт F5"/>
                
                <!-- Окно аналитики -->
                <Button Grid.Row="0" Tag="Аналитика" Content="Аналитика" Style="{StaticResource SubMenuButton}" Width="120" Margin="3"
                        Click="OpenPage_Click" ToolTip="Открыть раздел"/>

            </StackPanel>
            
            <!-- Поле ввода SQL -->
            <Border Grid.Row="1" Background="#FF222121">
                <RichTextBox x:Name="rtbRawSql" 
                     Background="Transparent" Foreground="White"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     TextChanged="rtbRawSql_TextChanged">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="LineHeight" Value="20"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Border>
        </Grid>

        <!--- Нижняя панель с кнопками и DataGrid -->
        <TabControl x:Name="tcOutput" Grid.Column="2" Grid.Row="3"
            Background="#FF222121" FontSize="18" BorderThickness="0">
            <!-- Панель DataOutput-->
            <TabItem Header="DataOutput">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF222121" Margin="5,0,0,0" Grid.ColumnSpan="2">
                        <!-- Режим редактирования -->
                        <Button Width="30" Height="30" Margin="2" BorderThickness="0" Content="✎"
                            Command="{Binding ToggleEditCommand}"
                            Style="{StaticResource SubMenuButton}" ToolTip="Режим редактирования"/>
                        
                        <!-- Добавить стрку -->
                        <Button Width="30" Height="30" Margin="2" BorderThickness="0" 
                                Command="{Binding AddNewRowCommand}"
                                Style="{StaticResource SubMenuButton}" ToolTip="Добавить строку">
                            <TextBlock Text="+" FontSize="20" Foreground="White"/>
                        </Button>

                        <!-- Сохранить изменения (виден только в режиме редактирования) -->
                        <Button Width="30" Height="30" Margin="2" BorderThickness="0" Content="💾"
                            Command="{Binding SaveChangesCommand}" Click="Save_Click"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SubMenuButton}" ToolTip="Сохранить изменения"/>

                        <!-- Удалить выбранные строки (виден только в режиме редактирования) -->
                        <Button Width="30" Height="30" Margin="2" BorderThickness="0" Content="🗑"
                            Command="{Binding DeleteRowsCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource SubMenuButton}" ToolTip="Удалить выбранные строки"/>

                        <!-- Кнопка поиска -->
                        <Button Width="30" Height="30" Margin="2" BorderThickness="0" Content="🔍" Command="{Binding SearchCommand}"
                                Style="{StaticResource SubMenuButton}" ToolTip="Поиск"/>

                        <!-- Поле поиска -->
                        <Grid>
                            <TextBox Visibility="Visible" Width="100" Height="25" BorderThickness="0.5" Background="Transparent" Foreground="White"
                                     Margin="2" Padding="3" FontSize="15" HorizontalAlignment="Left" TextAlignment="Left" VerticalAlignment="Center"
                                     x:Name="SearchBox" Text="{Binding SearchInput}"/>
                            <TextBlock Text="Поиск..." Margin="6,0,0,0" FontSize="15" 
                                       VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                       Style="{StaticResource SearchPreview}"/>
                        </Grid>

                        <!-- Кнопка экспорта -->
                        <Button Width="30" Height="30" Margin="2" ToolTip="Экспорт в Excel"
                                BorderThickness="0" Command="{Binding ExportCommand}" FontSize="15"
                                Style="{StaticResource SubMenuButton}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="15" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="dgData" Margin="5,5,0,0" AutoGenerateColumns="True" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                        IsReadOnly="{Binding IsReadOnlyMode}" Foreground="White" Background="#FF222121"
                        AutoGeneratingColumn="dgData_AutoGeneratingColumn" ItemsSource="{Binding TableData}"
                        LoadingRow="dgData_LoadingRow"
                        CanUserAddRows="{Binding IsEditMode}" CanUserDeleteRows="False"
                        BeginningEdit="dgData_BeginningEdit"
                        SelectionUnit="FullRow" SelectionMode="Extended" SelectionChanged="dgData_SelectionChanged"
                        GridLinesVisibility="None" RowBackground="#FF222121" AlternatingRowBackground="#FF2A2A2A"
                        EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </TabItem>

            <!-- Панель сообщений -->
            <TabItem Header="Messages">
                <TextBox Text="{Binding Messages, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="14" Margin="5">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#FFFF6B6B"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </TabItem>
       
        </TabControl>

        <!-- Верхняя черная панель и кнопки -->
        <Rectangle Fill="Black" Width="auto" Height="40" Grid.ColumnSpan="3" Grid.Row="0"/>

        <Button Content="x" Foreground="white" ToolTip="Закрыть" Grid.Column="2" HorizontalAlignment="Right" 
                Margin="0,5,10,0" Background="Transparent" BorderThickness="0" Click="Close_Click" IsCancel="True">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter/>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Label Content="?" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top"  
               Margin="0,2,35,0" ToolTip="Справка" Cursor="Help" Grid.Column="2">
            <Label.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Руководство пользователя" Click="OpenPage_Click"/>
                    <MenuItem Header="О программе" Click="OpenPage_Click"/>
                </ContextMenu>
            </Label.ContextMenu>
        </Label>

        <Frame Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Name="fmPage" 
               NavigationUIVisibility="Hidden" Visibility="Collapsed" Panel.ZIndex="2"/>

        <TreeView Grid.Row="1" Grid.RowSpan="3" Grid.Column="0" 
          BorderThickness="0" Background="#FF222121" Foreground="White"
          FontSize="14" SelectedItemChanged="TreeView_SelectedItemChanged">

            <TreeViewItem IsExpanded="True">
                <TreeViewItem.Header>
                    <TextBlock Text="Справочники" Style="{StaticResource TreeGroupHeader}"/>
                </TreeViewItem.Header>
                <TreeViewItem.ItemsSource>
                    <Binding Path="ReferenceTables"/>
                </TreeViewItem.ItemsSource>
                <TreeViewItem.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Margin="5,2,0,2"/>
                    </DataTemplate>
                </TreeViewItem.ItemTemplate>
            </TreeViewItem>
            
            <TreeViewItem IsExpanded="True">
                <TreeViewItem.Header>
                    <TextBlock Text="Рабочие данные" Style="{StaticResource TreeGroupHeader}"/>
                </TreeViewItem.Header>
                <TreeViewItem.ItemsSource>
                    <Binding Path="OtherTables"/>
                </TreeViewItem.ItemsSource>
                <TreeViewItem.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Margin="5,2,0,2"/>
                    </DataTemplate>
                </TreeViewItem.ItemTemplate>
            </TreeViewItem>

        </TreeView>

    </Grid>
</Window>