<Window x:Class="csharp_DBCourseWork_sem5.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="250" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#FF2D2D30">
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Настройки приложения" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <CheckBox x:Name="chkDarkTheme" Content="Тёмная тема" Foreground="White" FontSize="16" Margin="0,0,0,15"/>

            <Button Content="Сохранить" Click="btnSave_Click" Height="40" Background="#FF005A9E" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>