<Window x:Class="csharp_DBCourseWork_sem5.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="500" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#FF2D2D30">
        <StackPanel Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Смена пароля" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин:" Foreground="White"/>
            <TextBox x:Name="txtLogin" Height="30" Margin="0,5,0,15"/>

            <TextBlock Text="Старый пароль:" Foreground="White"/>
            <PasswordBox x:Name="txtOldPassword" Height="30" Margin="0,5,0,15"/>

            <TextBlock Text="Новый пароль:" Foreground="White"/>
            <PasswordBox x:Name="txtNewPassword" Height="30" Margin="0,5,0,15"/>

            <TextBlock Text="Повторите новый пароль:" Foreground="White"/>
            <PasswordBox x:Name="txtConfirmPassword" Height="30" Margin="0,5,0,15"/>

            <Button Content="Сменить пароль" Click="btnChangePassword_Click" Height="40" Background="#FF005A9E" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>